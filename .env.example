# SwarmSettle Environment Configuration (.env.example)
# Copy to .env only when connecting to a deployed NEAR Testnet contract.
# NEVER commit private keys, seed phrases, or API keys to version control.

# --- Frontend ---
VITE_NEAR_NETWORK=testnet
VITE_NEAR_RPC_URL=https://rpc.testnet.near.org
VITE_NEAR_CONTRACT_ID=swarmsettle.testnet
VITE_NEAR_WALLET_URL=https://testnet.mynearwallet.com
VITE_NEAR_EXPLORER_URL=https://testnet.nearblocks.io
# Keep false for the safe, clearly badged Simulation Preview.
VITE_DEFAULT_LIVE=false

# --- Live Testnet deployment / agent run (optional) ---
# NEAR_CONTRACT_ID=swarmsettle.testnet
# NEAR_RPC_URL=https://rpc.testnet.near.org
# CUSTOMER_ACCOUNT_ID=customer.testnet
# CUSTOMER_PRIVATE_KEY=ed25519:...
# RESEARCHPRO_PRIVATE_KEY=ed25519:...
# MARKETMIND_PRIVATE_KEY=ed25519:...
# VERIFYAI_PRIVATE_KEY=ed25519:...

# --- LLM provider for live agents (set one) ---
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
