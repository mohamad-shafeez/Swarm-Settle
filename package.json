{
  "name": "swarm-settle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SwarmSettle — Multi-agent work coordination, SHA-256 deliverable verification, and escrow settlement on NEAR Testnet",
  "scripts": {
    "test": "node scripts/test-contract-invariants.mjs",
    "verify": "node scripts/verify.mjs",
    "check": "npm test && npm run verify && npm --prefix app run build",
    "app:install": "npm --prefix app install",
    "app:dev": "npm --prefix app run dev",
    "app:build": "npm --prefix app run build",
    "agents:sim": "node agents/agent-runner.mjs --sim",
    "agents:live": "node agents/agent-runner.mjs --live",
    "deploy:testnet": "bash scripts/deploy-testnet.sh",
    "demo:record": "node scripts/record-demo.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0"
  }
}
